      "items": [
        {
          "slot": "interlocutor_claim",
          "number": 2024.0,
          "where": "elsewhere in paper",
          "claim": "The paper disputes the strategic efficacy of negative campaign advertisements by citing meta-analytic evidence that does not support their use for election success, contrasting this with the Democratic Party's reliance on such ads in 2024."
        }
      ]
    },
    "strength of claim": {
      "entries with quotes": 14,
      "causal word not in quote": 0,
      "hedge dropped": 5,
      "items": [
        {
          "slot": "question",
          "kind": "hedge",
          "word": "may",
          "claim": "The paper asks whether using stigmatizing labels like 'convicted criminal' in Democratic campaign advertisements against Trump causes a spillover effect that worsens Democrats' perceptions of individuals with criminal records more broadly."
        },
        {
          "slot": "question",
          "kind": "hedge",
          "word": "may",
          "claim": "The paper also investigates whether providing a counter-narrative featuring a formerly incarcerated representative can mitigate the negative effects of the stigmatizing advertisement."
        },
        {
          "slot": "key_findings",
          "kind": "hedge",
          "word": "appeared",
          "claim": "System-impacted individuals (those with personal or family experience with the justice system) reported significantly more positive perceptions of individuals with criminal records overall, and the negative effects of the advertisement were more damaging for this group."
        },
        {
          "slot": "theoretical_positioning",
          "kind": "hedge",
          "word": "may",
          "claim": "The authors ground their argument in social categorization theory, specifically focusing on category salience and the role of group exemplars, to explain how stigmatizing labels on a prominent figure spill over to perceptions of the broader group."
        },
        {
          "slot": "theoretical_positioning",
          "kind": "hedge",
          "word": "potential",
          "claim": "The paper extends the application of perspective-getting literature to the context of political messaging and criminal justice stigma, arguing that empathy-inducing narratives can serve as a viable alternative to negative campaigning."
        }
      ]
    },
