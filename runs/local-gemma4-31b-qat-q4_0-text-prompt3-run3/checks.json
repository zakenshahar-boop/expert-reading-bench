          "slot": "question",
          "kind": "hedge",
          "word": "may",
          "claim": "The study investigates whether using stigmatizing labels like \"convicted criminal\" for Donald Trump in Democratic advertisements negatively impacts Democrats' perceptions of people with criminal records and their sense of being represented."
        },
        {
          "slot": "central_claim",
          "kind": "hedge",
          "word": "suggest",
          "claim": "Stigmatizing labels in campaign advertisements negatively affect Democrats' perceptions of individuals with criminal records while improving feelings of representation, though a counter-narrative featuring a system-involved representative can mitigate the negative perceptions."
        },
        {
          "slot": "key_findings",
          "kind": "causal",
          "word": "led to",
          "claim": "The use of a counter-narrative led to decreased support for the Trump advertisement and a lower perception of its effectiveness."
        },
        {
          "slot": "key_findings",
          "kind": "hedge",
          "word": "appeared",
          "claim": "The Trump advertisement's stigmatizing labels were more damaging to the perceptions of people with criminal records for participants who identified as system-impacted."
        },
        {
          "slot": "scope_and_limits",
          "kind": "hedge",
          "word": "possible",
          "claim": "The study does not distinguish whether the negative effects were caused by the stigmatizing text or the visual image of the mugshot."
        },
        {
          "slot": "scope_and_limits",
          "kind": "causal",
          "word": "influenced",
          "claim": "There is a possibility that responses were influenced by generative AI agents, a known risk in online survey research."
        },
        {
          "slot": "theoretical_positioning",
          "kind": "causal",
          "word": "cause",
          "claim": "The authors employ social categorization theory to argue that stigmatizing a group exemplar can cause perceptions to spill over to the entire category."
        },
        {
          "slot": "theoretical_positioning",
          "kind": "hedge",
          "word": "may",
          "claim": "The authors employ social categorization theory to argue that stigmatizing a group exemplar can cause perceptions to spill over to the entire category."
        }
      ]
