        {
          "slot": "central_claim",
          "kind": "hedge",
          "word": "suggest",
          "claim": "Exposure to the Trump ad labeling him a 'convicted criminal' lowered Democrats' perceptions of people with records, and a formerly system-involved representative's perspective shown before the ad largely offset that effect."
        },
        {
          "slot": "key_findings",
          "kind": "causal",
          "word": "effect on",
          "claim": "Placing a system-impacted state representative's perspective before the ad almost entirely offset the ad's negative effect on perceptions of people with records."
        },
        {
          "slot": "key_findings",
          "kind": "causal",
          "word": "effects of",
          "claim": "The effects of the ad and counter-narrative on perceptions of people with records were larger for system-impacted respondents than for others."
        },
        {
          "slot": "theoretical_positioning",
          "kind": "hedge",
          "word": "suggest",
          "claim": "The authors place the study within social categorization theory and extend it to argue that a stigmatizing label applied to one salient group member spills over to the wider category of people with records."
        }
      ]
    },
