      "items": [
        {
          "slot": "question",
          "number": 19.0,
          "where": "elsewhere in paper",
          "claim": "The paper asks how online partisan polarization about COVID-19 measures varies across U.S. states and Canadian provinces, and how it relates to political leaning, conspiracy content, and vaccination rates."
        },
        {
          "slot": "central_claim",
          "number": 19.0,
          "where": "elsewhere in paper",
          "claim": "Politically conservative regions show significantly higher partisan polarization in online COVID-19 discussion in both countries, more strongly in the U.S., and U.S. regional vaccination rates are strongly negatively correlated with polarization in vaccine discussions."
        },
        {
          "slot": "evidence",
          "number": 1.0,
          "where": "elsewhere in paper",
          "claim": "The main corpus is COVID-19 political tweets from the U.S. and Canada, collected from a 1% Twitter API sample between October 9, 2020 and January 4, 2021."
        }
      ]
    },
